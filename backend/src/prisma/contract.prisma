// use prisma-8

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String?
  priceCents    Int
  stockQuantity Int      @default(0)

  // Temporary legacy image field.
  // We will remove this after all old image URLs are migrated/deleted.
  imageUrl      String?

  isActive      Boolean  @default(true)

  // Controls storefront ordering.
  // Lower number = shown earlier.
  displayOrder  Int      @default(0)

  images        ProductImage[]

  createdAt     DateTime(as: string) @onCreate(now())
  updatedAt     DateTime(as: string) @onCreate(now()) @onUpdate(now())
}

model ProductImage {
  id          Int      @id @default(autoincrement())

  productId   Int
  product     Product  @relation(fields: [productId], references: [id])

  storagePath String
  altText     String?
  position    Int      @default(0)

  createdAt   DateTime(as: string) @onCreate(now())
}